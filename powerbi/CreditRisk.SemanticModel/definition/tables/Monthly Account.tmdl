table 'Monthly Account'
	lineageTag: c4b018d1-d8cc-596a-9da8-3b6498535d91

	/// Share of customer-months 2+ months late. Comparable across months (status 1 is only coded in Sep).
	measure '2+ months late rate' = DIVIDE(SUM('Monthly Account'[2+ months late]), COUNTROWS('Monthly Account'))
		formatString: 0.0%
		lineageTag: b9202d0e-22bc-5d34-828e-948dc49e2be9

	/// Average balance / credit limit.
	measure 'Avg utilisation' = AVERAGE('Monthly Account'[Utilisation])
		formatString: 0.0%
		lineageTag: 10267178-d6ee-5386-bac0-13a84cf25706

	/// Share of customer-months with a balance above the limit.
	measure 'Over-limit rate' = DIVIDE(SUM('Monthly Account'[Over limit]), COUNTROWS('Monthly Account'))
		formatString: 0.0%
		lineageTag: fbf983cf-c879-5dfc-9f40-b6441a6b19ad

	/// Payments as a share of positive statement balances.
	measure 'Paid to billed' = DIVIDE(SUM('Monthly Account'[Payment amount]), SUMX('Monthly Account', MAX('Monthly Account'[Bill amount], 0)))
		formatString: 0.0%
		lineageTag: 7ee06966-c8bf-50f0-a726-71835fc8350d

