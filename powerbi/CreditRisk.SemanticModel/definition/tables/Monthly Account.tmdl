				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    View = Source{[Schema = "analytics", Item = "vw_monthly_account"]}[Data],
				    Selected = Table.SelectColumns(View, {"customer_id", "statement_month", "month_order", "month_label", "pay_status", "pay_status_label", "months_delayed", "is_delinquent_2plus", "is_over_limit", "bill_amount", "payment_amount", "utilisation"}),
				    Renamed = Table.RenameColumns(Selected, {{"customer_id", "Customer ID"}, {"statement_month", "Statement month"}, {"month_order", "Month order"}, {"month_label", "Month"}, {"pay_status", "Repayment status code"}, {"pay_status_label", "Repayment status"}, {"months_delayed", "Months late"}, {"is_delinquent_2plus", "2+ months late"}, {"is_over_limit", "Over limit"}, {"bill_amount", "Bill amount"}, {"payment_amount", "Payment amount"}, {"utilisation", "Utilisation"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Customer ID", Int64.Type}, {"Statement month", type date}, {"Month order", Int64.Type}, {"Month", type text}, {"Repayment status code", Int64.Type}, {"Repayment status", type text}, {"Months late", Int64.Type}, {"2+ months late", Int64.Type}, {"Over limit", Int64.Type}, {"Bill amount", Int64.Type}, {"Payment amount", Int64.Type}, {"Utilisation", type number}})
