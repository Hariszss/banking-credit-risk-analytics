table Customer
	lineageTag: d2b36d06-8f5e-59ee-bc7a-f015575c9ff0

	/// Number of customers in the current filter context.
	measure Customers = COUNTROWS(Customer)
		formatString: #,0
		lineageTag: 1793c6a2-19a6-595d-8f7b-feccf5892faa

	/// Customers who defaulted in Oct 2005.
	measure Defaults = SUM(Customer[Defaulted (Oct)])
		formatString: #,0
		lineageTag: 27915cba-5a48-5bf8-abe4-36735cb87df9

	/// Share of customers who defaulted in Oct 2005.
	measure 'Default rate' = DIVIDE([Defaults], [Customers])
		formatString: 0.0%
		lineageTag: 6c6c8946-2976-5ec4-9082-aeb2fe6e38d9

	/// Default rate of the whole portfolio, ignoring filters.
	measure 'Portfolio default rate' = CALCULATE([Default rate], REMOVEFILTERS(Customer))
		formatString: 0.0%
		lineageTag: 526334a3-e603-5784-810c-aefacbbb3965

	/// Default rate relative to the portfolio. Above 1 = riskier than average.
	measure 'Default rate lift' = DIVIDE([Default rate], [Portfolio default rate])
		formatString: 0.00x
		lineageTag: bdf5f12e-c88e-554d-a469-19e0c4553673

	/// Sum of credit limits (not exposure at default).
	measure 'Total credit limit' = SUM(Customer[Credit limit])
		formatString: #,0
		lineageTag: 5f7dd5e4-9012-57bd-9a6a-aa5e1d87d260

	/// Positive statement balances in Sep 2005.
	measure 'Balance (Sep) total' = SUMX(Customer, MAX(Customer[Balance (Sep)], 0))
		formatString: #,0
		lineageTag: 536c3bda-2f81-5b22-b1c6-5e5670605d13

	/// Average Sep balance / credit limit.
	measure 'Avg utilisation (Sep)' = AVERAGE(Customer[Utilisation (Sep)])
		formatString: 0.0%
		lineageTag: 6eae7bfc-0a6f-5932-93b0-4fb2abd5ce82

	/// Share of customers with a predicted PD of 25% or more.
	measure 'Share high risk' = DIVIDE(CALCULATE([Customers], Customer[Risk band] IN {"3. High (25-50%)", "4. Very high (50%+)"}), [Customers])
		formatString: 0.0%
		lineageTag: ca4636ee-5dfd-5fc1-ae6d-8504f46300bb

	/// Average model probability of default.
	measure 'Avg predicted PD' = AVERAGE(Customer[Predicted PD])
		formatString: 0.0%
		lineageTag: a40dee09-bdf2-5210-b45a-7319a9700cf9

	/// Number of defaults the model expects (sum of PDs).
	measure 'Expected defaults' = SUM(Customer[Predicted PD])
		formatString: #,0
		lineageTag: c8b03857-5cbc-57e6-8616-c500f88b8fb5

	/// Capture rate: share of all defaulters that fall in this group.
	measure 'Share of all defaulters' = DIVIDE([Defaults], CALCULATE([Defaults], ALLSELECTED(Customer)))
		formatString: 0.0%
		lineageTag: ba5657be-dbd8-581b-8a25-be75196f5967

	/// Sep balance weighted by predicted PD. Indicative only: no LGD or EAD model.
	measure 'PD-weighted balance (Sep)' = SUMX(Customer, Customer[Predicted PD] * MAX(Customer[Balance (Sep)], 0))
		formatString: #,0
		lineageTag: ba74e773-65ce-5760-8f7e-98fb836e4abb

	column 'Customer ID'
