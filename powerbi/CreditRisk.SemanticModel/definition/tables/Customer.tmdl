	partition Customer = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    View = Source{[Schema = "analytics", Item = "vw_customer_risk"]}[Data],
				    Selected = Table.SelectColumns(View, {"customer_id", "age", "age_band", "sex_label", "education_group", "marriage_group", "credit_limit", "credit_limit_band", "latest_pay_status", "latest_pay_status_label", "latest_months_delayed", "latest_bill_amount", "latest_utilisation", "utilisation_band", "avg_utilisation_6m", "months_delinquent_6m", "early_warning_segment", "default_next_month", "pd_score", "risk_decile", "risk_band"}),
				    Renamed = Table.RenameColumns(Selected, {{"customer_id", "Customer ID"}, {"age", "Age"}, {"age_band", "Age band"}, {"sex_label", "Sex"}, {"education_group", "Education"}, {"marriage_group", "Marital status"}, {"credit_limit", "Credit limit"}, {"credit_limit_band", "Credit limit band"}, {"latest_pay_status", "Repayment status code (Sep)"}, {"latest_pay_status_label", "Repayment status (Sep)"}, {"latest_months_delayed", "Months late (Sep)"}, {"latest_bill_amount", "Balance (Sep)"}, {"latest_utilisation", "Utilisation (Sep)"}, {"utilisation_band", "Utilisation band (Sep)"}, {"avg_utilisation_6m", "Avg utilisation (6m)"}, {"months_delinquent_6m", "Months late (last 6)"}, {"early_warning_segment", "Rule-based segment"}, {"default_next_month", "Defaulted (Oct)"}, {"pd_score", "Predicted PD"}, {"risk_decile", "Risk decile"}, {"risk_band", "Risk band"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Customer ID", Int64.Type}, {"Age", Int64.Type}, {"Age band", type text}, {"Sex", type text}, {"Education", type text}, {"Marital status", type text}, {"Credit limit", Int64.Type}, {"Credit limit band", type text}, {"Repayment status code (Sep)", Int64.Type}, {"Repayment status (Sep)", type text}, {"Months late (Sep)", Int64.Type}, {"Balance (Sep)", Int64.Type}, {"Utilisation (Sep)", type number}, {"Utilisation band (Sep)", type text}, {"Avg utilisation (6m)", type number}, {"Months late (last 6)", Int64.Type}, {"Rule-based segment", type text}, {"Defaulted (Oct)", Int64.Type}, {"Predicted PD", type number}, {"Risk decile", Int64.Type}, {"Risk band", type text}}),
				    WithOutcome = Table.AddColumn(Typed, "Outcome", each if [#"Defaulted (Oct)"] = 1 then "Defaulted in Oct" else "Did not default", type text)
				in
				    WithOutcome

	annotation PBI_ResultType = Table
